# No compiler binaries or media are redistributed from this repo — every
# image downloads its pinned source at build time.  Local tarball artifacts
# (e.g. unpacked media trees) must never be staged.
*.tar.xz
*.tar.gz
# Unpacked media trees: `rebrew toolchain vendor` assembles the host tree into
# <family>/<version>-<arch>/source (hundreds of MB, rebuilt on demand).
source/

# Python bytecode from the test suite and the migration tooling.
__pycache__/

# Analyzer state from `make lint` (ruff, mypy) and uv environments.
.mypy_cache/
.ruff_cache/
.venv/
.scratch/
